/* THE REDOLENT HOUR — core styles */
:root {
  --ink: #211b17;
  --paper: #f3ede4;
  --cream: #e5d8c7;
  --wine: #55362f;
  --sage: #7c806d;
  --line: rgba(33, 27, 23, 0.18);
  --serif: "Cormorant Garamond", Georgia, serif;
  --sans: "Manrope", Arial, sans-serif;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: var(--sans);
  font-weight: 300;
  overflow-x: hidden;
}

a { color: inherit; text-decoration: none; }
img { max-width: 100%; display: block; }

.grain {
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: .06;
  z-index: 999;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.55'/%3E%3C/svg%3E");
}

.site-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  min-height: 74px;
  padding: 0 5vw;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid transparent;
  transition: background .35s ease, border-color .35s ease;
}
.site-header.scrolled {
  background: rgba(243, 237, 228, .88);
  backdrop-filter: blur(16px);
  border-color: var(--line);
}
.brand {
  font-family: var(--serif);
  font-size: 1.45rem;
  font-weight: 600;
  letter-spacing: .02em;
}
.nav { display: flex; gap: 2rem; font-size: .78rem; text-transform: uppercase; letter-spacing: .14em; }
.nav a { position: relative; }
.nav a::after {
  content: "";
  position: absolute;
  left: 0; right: 100%; bottom: -5px;
  height: 1px; background: currentColor;
  transition: right .25s ease;
}
.nav a:hover::after { right: 0; }
.menu-toggle { display: none; }

.hero {
  min-height: 100svh;
  padding: 18vh 6vw 8vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  position: relative;
  isolation: isolate;
}
.hero h1 {
  margin: .35rem 0 1.1rem;
  font-family: var(--serif);
  font-size: clamp(5rem, 13vw, 11rem);
  line-height: .72;
  font-weight: 500;
  letter-spacing: -.055em;
}
.hero h1 em { font-weight: 500; }
.eyebrow {
  margin: 0;
  font-size: .7rem;
  font-weight: 500;
  letter-spacing: .22em;
  text-transform: uppercase;
}
.tagline {
  max-width: 560px;
  margin: 1.6rem auto;
  font-family: var(--serif);
  font-size: clamp(1.25rem, 2.5vw, 2rem);
  font-style: italic;
  line-height: 1.25;
}
.hero-orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(2px);
  z-index: -1;
  animation: drift 9s ease-in-out infinite alternate;
}
.hero-orb-one {
  width: 32vw; height: 32vw; min-width: 260px; min-height: 260px;
  background: radial-gradient(circle at 35% 35%, rgba(123, 84, 71, .34), rgba(123, 84, 71, 0) 70%);
  left: -8vw; top: 14vh;
}
.hero-orb-two {
  width: 27vw; height: 27vw; min-width: 220px; min-height: 220px;
  background: radial-gradient(circle at 50% 50%, rgba(126, 133, 105, .28), rgba(126, 133, 105, 0) 70%);
  right: -5vw; bottom: 8vh;
  animation-delay: -3s;
}
@keyframes drift {
  to { transform: translate3d(3vw, -2vh, 0) scale(1.08); }
}

.text-link {
  display: inline-flex;
  gap: .6rem;
  align-items: center;
  font-size: .74rem;
  font-weight: 500;
  letter-spacing: .14em;
  text-transform: uppercase;
  border-bottom: 1px solid currentColor;
  padding-bottom: .35rem;
}
.text-link span { transition: transform .25s ease; }
.text-link:hover span { transform: translate(3px, -3px); }

.section-pad { padding: 9rem 6vw; }
.section-number {
  margin: 0 0 2rem;
  font-size: .65rem;
  letter-spacing: .18em;
  opacity: .55;
}

.manifesto {
  display: grid;
  grid-template-columns: 1fr 3fr;
  border-top: 1px solid var(--line);
}
.manifesto-copy p {
  margin: 0;
  max-width: 980px;
  font-family: var(--serif);
  font-size: clamp(2.3rem, 5vw, 5.7rem);
  line-height: .98;
  letter-spacing: -.035em;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  border-bottom: 1px solid var(--line);
  margin-bottom: 3rem;
}
.section-heading h2 {
  font-family: var(--serif);
  font-size: clamp(2.5rem, 5vw, 5rem);
  font-weight: 500;
  letter-spacing: -.035em;
  margin: 0 0 1.5rem;
}

.featured-grid {
  display: grid;
  grid-template-columns: 1.25fr .75fr;
  gap: 3rem;
}
.card-visual {
  display: block;
  min-height: 58vh;
  background-size: cover;
  background-position: center;
  overflow: hidden;
  position: relative;
}
.card-visual::after {
  content: "";
  position: absolute; inset: 0;
  background: linear-gradient(135deg, transparent, rgba(255,255,255,.18));
  transform: translateX(-100%);
  transition: transform .8s ease;
}
.card-visual:hover::after { transform: translateX(100%); }
.visual-rose {
  background:
    radial-gradient(circle at 68% 25%, rgba(238, 214, 210, .9) 0 6%, transparent 7%),
    radial-gradient(circle at 60% 40%, rgba(145, 79, 78, .72), transparent 25%),
    linear-gradient(145deg, #9b6964, #3f2f2e);
}
.visual-tea {
  background:
    radial-gradient(ellipse at 48% 64%, rgba(210, 159, 82, .72), transparent 20%),
    linear-gradient(165deg, #b6a78b, #4b4033 75%);
}
.card-meta {
  display: flex;
  justify-content: space-between;
  margin: 1.1rem 0 .6rem;
  font-size: .66rem;
  letter-spacing: .16em;
  text-transform: uppercase;
}
.feature-card h3 {
  font-family: var(--serif);
  font-size: clamp(2rem, 3vw, 3.6rem);
  font-weight: 500;
  margin: 0;
}
.feature-card p { max-width: 580px; line-height: 1.8; font-size: .92rem; }

.split-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  padding-left: 0;
  padding-right: 0;
}
.topic-panel {
  padding: 8rem 6vw;
  min-height: 76vh;
  background: var(--cream);
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.topic-panel.dark {
  background: var(--wine);
  color: var(--paper);
}
.topic-panel h2, .about h2 {
  font-family: var(--serif);
  font-size: clamp(3rem, 6vw, 6.5rem);
  font-weight: 500;
  line-height: .88;
  letter-spacing: -.05em;
  margin: 1rem 0 2rem;
}
.topic-panel > p:not(.section-number):not(.eyebrow) {
  max-width: 480px;
  line-height: 1.8;
  margin-bottom: 2rem;
}

.about {
  display: grid;
  grid-template-columns: .75fr 2fr;
  gap: 3rem;
}
.about-copy p { max-width: 640px; line-height: 1.9; }

footer {
  min-height: 160px;
  padding: 3rem 6vw;
  border-top: 1px solid var(--line);
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  font-size: .72rem;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.reveal {
  opacity: 0;
  transform: translateY(32px);
  transition: opacity .9s ease, transform .9s cubic-bezier(.2,.7,.2,1);
}
.reveal.visible { opacity: 1; transform: none; }
.delay-1 { transition-delay: .12s; }
.delay-2 { transition-delay: .24s; }
.delay-3 { transition-delay: .36s; }

@media (max-width: 760px) {
  .site-header { min-height: 64px; }
  .menu-toggle {
    display: block;
    border: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    font-size: .72rem;
    text-transform: uppercase;
    letter-spacing: .15em;
  }
  .nav {
    position: absolute;
    top: 64px;
    left: 0; right: 0;
    display: none;
    flex-direction: column;
    gap: 0;
    padding: 1rem 5vw 1.5rem;
    background: rgba(243,237,228,.98);
    border-bottom: 1px solid var(--line);
  }
  .nav.open { display: flex; }
  .nav a { padding: .9rem 0; }
  .hero { padding-top: 14vh; }
  .hero h1 { font-size: clamp(4.2rem, 23vw, 7rem); }
  .section-pad { padding: 6rem 6vw; }
  .manifesto, .about { grid-template-columns: 1fr; }
  .manifesto-copy p { font-size: clamp(2.6rem, 12vw, 4.8rem); }
  .section-heading { display: block; }
  .featured-grid, .split-section { grid-template-columns: 1fr; }
  .featured-grid { gap: 5rem; }
  .card-visual { min-height: 58vh; }
  .topic-panel { min-height: 68vh; }
  footer { align-items: flex-start; flex-direction: column; justify-content: center; gap: .7rem; }
}

@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    scroll-behavior: auto !important;
    animation: none !important;
    transition: none !important;
  }
  .reveal { opacity: 1; transform: none; }
}
